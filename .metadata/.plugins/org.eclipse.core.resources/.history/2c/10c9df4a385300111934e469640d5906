spring.application.name=api-gateway
server.port=8079
spring.config.import=optional:configserver:http://localhost:8888
eureka.client.service-url.defaultZone=http://localhost:8761/eureka
eureka.instance.prefer-ip-address=true
eureka.instance.hostname=localhost

# JWT secret - same value must be set in identity-service
# In production, override via env var: APP_JWT_SECRET
app.jwt.secret=${APP_JWT_SECRET:KZ9A$S3D@F8r#pL1!Zx7H*R6ewYV%TmUqC2M0}

# CORS for Angular frontend (dev)
spring.cloud.gateway.server.webflux.globalcors.cors-configurations.[/**].allowed-origins=http://localhost:4200
spring.cloud.gateway.server.webflux.globalcors.cors-configurations.[/**].allowed-methods=GET,POST,PUT,DELETE,OPTIONS
spring.cloud.gateway.server.webflux.globalcors.cors-configurations.[/**].allowed-headers=*
spring.cloud.gateway.server.webflux.globalcors.cors-configurations.[/**].allow-credentials=true

# Gateway routes stay here - not in config server
# because gateway config is complex and service-specific
spring.cloud.gateway.server.webflux.routes[0].id=identity-public-route
spring.cloud.gateway.server.webflux.routes[0].uri=lb://identity-service
spring.cloud.gateway.server.webflux.routes[0].predicates[0]=Path=/auth/**

spring.cloud.gateway.server.webflux.routes[1].id=identity-protected-route
spring.cloud.gateway.server.webflux.routes[1].uri=lb://identity-service
spring.cloud.gateway.server.webflux.routes[1].predicates[0]=Path=/users/**,/audit/**
spring.cloud.gateway.server.webflux.routes[1].filters[0]=JwtAuthFilter

spring.cloud.gateway.server.webflux.routes[2].id=member-service-route
spring.cloud.gateway.server.webflux.routes[2].uri=lb://MEMBER-SERVICE
spring.cloud.gateway.server.webflux.routes[2].predicates[0]=Path=/members/**,/accounts/**
spring.cloud.gateway.server.webflux.routes[2].filters[0]=JwtAuthFilter

spring.cloud.gateway.server.webflux.routes[3].id=loan-service-route
spring.cloud.gateway.server.webflux.routes[3].uri=lb://LOAN-SERVICE
spring.cloud.gateway.server.webflux.routes[3].predicates[0]=Path=/loans/**,/loan-approval/**
spring.cloud.gateway.server.webflux.routes[3].filters[0]=JwtAuthFilter

spring.cloud.gateway.server.webflux.routes[4].id=repayment-service-route
spring.cloud.gateway.server.webflux.routes[4].uri=lb://REPAYMENT-SERVICE
spring.cloud.gateway.server.webflux.routes[4].predicates[0]=Path=/api/repayments/**,/api/delinquencies/**
spring.cloud.gateway.server.webflux.routes[4].filters[0]=JwtAuthFilter

spring.cloud.gateway.server.webflux.routes[5].id=transaction-service-route
spring.cloud.gateway.server.webflux.routes[5].uri=lb://TRANSACTION-SERVICE
spring.cloud.gateway.server.webflux.routes[5].predicates[0]=Path=/api/transactions/**,/api/account/**
spring.cloud.gateway.server.webflux.routes[5].filters[0]=JwtAuthFilter

spring.cloud.gateway.server.webflux.routes[6].id=reporting-service-route
spring.cloud.gateway.server.webflux.routes[6].uri=lb://REPORTING-SERVICE
spring.cloud.gateway.server.webflux.routes[6].predicates[0]=Path=/reports/**,/kpi/**,/audit-packages/**,/api/notifications/**,/api/tasks/**
spring.cloud.gateway.server.webflux.routes[6].filters[0]=JwtAuthFilter

