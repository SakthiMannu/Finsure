package com.finsure.entity;

import jakarta.persistence.*;
import lombok.AllArgsConstructor;
import lombok.Data;
import lombok.NoArgsConstructor;

import java.time.LocalDate;

// Account belongs to a Member
// In microservices, Member and Account are in the same service
// because they are tightly related - you always need member to create account
@Entity
@Table(name = "account")
@Data
@NoArgsConstructor
@AllArgsConstructor
public class Account {

    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    private Long accountId;

    // Type: SAVINGS or CHECKING
    private String type;

    private double balance;
    private LocalDate createdAt;

    // Status: ACTIVE or CLOSED
    private String status;

    // ManyToOne join - one member can have multiple accounts
    @ManyToOne
    @JoinColumn(name = "member_id")
    private Member member;
}
