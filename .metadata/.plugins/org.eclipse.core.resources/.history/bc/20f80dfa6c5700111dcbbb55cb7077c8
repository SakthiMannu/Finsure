package com.finsure.repository;

import java.time.LocalDate;
import java.util.Optional;

import org.springframework.data.jpa.repository.JpaRepository;

import com.finsure.entity.Member;

public interface MemberRepository extends JpaRepository<Member, Long> {

    // Spring Data auto-generates SQL: SELECT * FROM members WHERE name=? AND dob=?
    // Used to prevent duplicate member registrations
    boolean existsByNameAndDob(String name, LocalDate dob);
    Optional<Member> findByContactInfo(String contactInfo);
}