package com.finsure.entity;

import jakarta.persistence.*;
import lombok.AllArgsConstructor;
import lombok.Data;
import lombok.NoArgsConstructor;

import java.time.LocalDate;

// Stores documents uploaded for a loan application
// Many documents can belong to one loan
@Entity
@Table(name = "loan_document")
@Data
@NoArgsConstructor
@AllArgsConstructor
public class LoanDocument {

    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    private Long docId;

    private String fileURI;
    private LocalDate uploadedAt;
    private String verifiedBy;

    // Status values: PENDING, VERIFIED, REJECTED
    private String status;

    // Links to LoanApplication in same database - JPA join is fine here
    @ManyToOne
    @JoinColumn(name = "loan_id")
    private LoanApplication loan;

}